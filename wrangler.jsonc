{
  "name": "jamiequigley-com",
  "compatibility_date": "2026-10-18",
  "routes": [{ "pattern": "jamiequigley.com", "custom_domain": true }],
  // Static assets only: no Worker script runs, and unknown paths serve
  // index.html so React Router can handle them.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
